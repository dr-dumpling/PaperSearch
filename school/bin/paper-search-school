#!/bin/sh
# Runs the CLI from this checkout. Python: $SCHOOL_PYTHON, else the checkout's own
# .venv (pip install -e ".[ego,dev]"; the browser is the installed Google Chrome).
HERE="$(cd "$(dirname "$0")/.." && pwd)"
if [ -n "$SCHOOL_PYTHON" ]; then
  PY="$SCHOOL_PYTHON"
elif [ -x "$HERE/.venv/bin/python" ]; then
  PY="$HERE/.venv/bin/python"
else
  echo "paper-search-school：找不到 Python。请在 $HERE/.venv 建虚拟环境，或设置 SCHOOL_PYTHON。" >&2
  exit 1
fi
export PYTHONPATH="$HERE${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m paper_search_school.cli "$@"
