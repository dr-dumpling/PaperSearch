{
  "manifest_version": 2,
  "name": "PaperSearch background browser",
  "version": "1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "background@papersearch.local"
    }
  },
  "experiment_apis": {
    "papersearchBackground": {
      "schema": "schema.json",
      "parent": {
        "scopes": [
          "addon_parent"
        ],
        "events": [
          "startup"
        ],
        "script": "api.js"
      }
    }
  }
}
